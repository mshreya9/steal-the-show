# Firebase web app config — from Firebase Console > Project Settings > General > Your apps.
# Copy this file to .env and fill in real values. Never commit .env.
#
# Setup checklist:
# 1. Create a free project at https://console.firebase.google.com
# 2. Authentication > Sign-in method: enable "Phone"
#    (Email is collected at registration but not verified in this phase.)
# 3. Authentication > Settings > Authorized domains: add localhost (and your deploy domain)
# 4. Build a Firestore database (test mode is fine for a class demo)
# 5. Project settings > General > Your apps > add a Web app, copy the config values below

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Pexels API — from https://www.pexels.com/api (free, no credit card).
# Used to fetch real product photography. If left blank, product cards
# fall back to the generated placeholder look automatically.
VITE_PEXELS_API_KEY=
